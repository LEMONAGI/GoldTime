{
  "sourceLanguage": "ko",
  "strings": {
    "notification.openApp.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to do in GoldTime if you want more time. Leave now and there's no ad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっと使うにはGoldTimeで選んでください。今閉じれば広告なしで終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 쓰려면 GoldTime에서 선택하세요. 지금 나가면 광고 없이 끝납니다."
          }
        }
      }
    },
    "notification.openApp.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time's Up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限に達しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도 끝났어요"
          }
        }
      }
    }
  },
  "version": "1.0"
}
