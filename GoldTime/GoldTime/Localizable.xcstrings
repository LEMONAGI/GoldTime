    "content.alert.applyNotice.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage can't be tracked after 11:45 PM, so the lock will stay off until 11:59 PM. The rule will take effect at midnight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "23:45以降は使用量を計測できないため23:59までロックが解除されたままになり、00:00からルールが適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "23:45부터는 사용량 추적이 불가능해 23:59까지 잠금이 해제되며, 00:00부터 규칙이 적용됩니다."
          }
        }
      }
    },
    "content.alert.applyNotice.title": {
      "extractionState": "manual",
