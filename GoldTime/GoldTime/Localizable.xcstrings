    "home.bill.comment0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A great day. Just not for me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いい日ですね。私にとっては違いますけど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 날입니다. 저한텐 아니고요."
          }
        }
      }
    },
    "home.bill.comment1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can let this one slide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これくらいなら見逃してあげられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정도면 살짝 눈 감아드릴 수 있어요."
          }
        }
      }
    },
    "home.bill.comment2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bill is ready. Care to look?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求書が出ました。確認してみますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산서 나왔어요. 확인해보실래요?"
          }
        }
      }
    },
    "home.bill.comment3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been busy. Feel that bill getting heavier?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なかなかやりますね。請求書の厚みを感じるでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제법 하시는데요. 청구서 두께가 느껴지시죠?"
          }
        }
      }
    },
    "home.bill.comment4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm starting to enjoy this. Me, specifically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そろそろ機嫌が良くなってきました。私がですよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬슬 기분이 좋아지는데요. 제가요."
          }
        }
      }
    },
    "home.bill.comment5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
