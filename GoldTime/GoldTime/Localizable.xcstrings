    "onboarding.error.screenTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time access is required. Tap the button again and allow access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린타임 권한이 필요해요. 다시 한 번 버튼을 눌러 권한을 허용해주세요."
          }
        }
      }
    },
    "onboarding.intro.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you go over a limit you set,\nyour chosen apps will lock.\nMore time costs an ad.\nWe'll make that moment hard to ignore,\nso you remember what your time is worth."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스스로 정한 한도를 넘기면 선택한 앱이 잠기고,\n더 쓰려면 광고로 시간을 구매해야 합니다.\n당신이 시간의 소중함을 느낄 수 있도록,\n한도를 넘기는 순간을 의식하게 만들겠습니다."
          }
        }
      }
    },
    "onboarding.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Is Money"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 금이다"
          }
        }
      }
    },
    "onboarding.note.notification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose ‘Allow,’ not ‘Allow in Scheduled Summary,’ to receive notifications immediately"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'시간 지정 요약에서 허용'이 아닌 '허용'을 선택해야 즉시 알림을 받을 수 있어요"
