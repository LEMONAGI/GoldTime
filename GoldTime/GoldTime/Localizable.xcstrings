    "onboarding.dialog.tracking.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your activity across other companies’ apps and websites may be used for personalized ads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appやウェブでのアクティビティが、パーソナライズされた広告に使用される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
