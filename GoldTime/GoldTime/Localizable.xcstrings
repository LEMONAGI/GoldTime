            "state": "translated",
            "value": "시간이 금이라는 거 기억하시죠."
          }
        }
      }
    },
    "notification.morning.over3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday's bill was a little heavy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
