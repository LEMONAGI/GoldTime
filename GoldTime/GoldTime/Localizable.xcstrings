          }
        }
      }
    },
    "rule.commit.adNotice.message": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 그룹은 광고를 본 뒤에 편집할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
