    "notif.appReturn.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll tell you to return to GoldTime when you reach a limit. This one is essential, so it can't be turned off."
          }
        },
