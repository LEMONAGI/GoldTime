    "content.nearMidnightEditNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules set after 11:45 PM can't track usage accurately until midnight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "23:45以降に設定したルールは使用量を計測できないため、00:00から改めて正確に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "23:45부터 설정한 규칙은 사용량 추적이 불가능해 00:00부터 다시 정확히 적용됩니다."
          }
        }
      }
    },
    "content.recovery.errorMessage": {
      "extractionState": "manual",
