    "content.limitWarning.cooldown.message %lld %lld %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already used %1$lld min. If you change the usage time to %2$lld min, ‘%3$@’ will start a break immediately. Continue?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 %1$lld분 사용해서, 사용 시간을 %2$lld분으로 바꾸면 ‘%3$@’ 그룹이 바로 휴식에 들어가요. 변경할까요?"
          }
        }
      }
    },
    "content.limitWarning.cooldown.title": {
      "extractionState": "manual",
