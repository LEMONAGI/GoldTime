          }
        }
      }
    },
    "content.limitWarning.dailyLimit.message %lld %lld %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already used %1$lld min. If you change the limit to %2$lld min, ‘%3$@’ will lock immediately. Continue?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 %1$lld분 사용해서, %2$lld분으로 바꾸면 ‘%3$@’ 그룹이 바로 잠겨요. 변경할까요?"
          }
