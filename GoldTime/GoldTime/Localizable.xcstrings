    "content.apply.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will apply to ‘%@’ now. After that, you'll need to watch an ad to change the rule or items, or to delete the group."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 지금부터 적용돼요. 이후 규칙이나 항목을 바꾸거나 삭제하려면 광고를 봐야 해요."
          }
        }
      }
    },
    "content.apply.title": {
      "extractionState": "manual",
