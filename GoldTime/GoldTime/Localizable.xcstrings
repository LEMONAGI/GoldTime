    "strict.confirm.body %lld %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked for %lld days. Unlocks at midnight on %@, and not before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日間ロックされます。%@ 0時に解除され、それまで開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 동안 잠겨요. %@ 0시에 풀리고, 그 전엔 못 열어요."
          }
        }
      }
    },
    "strict.confirm.button": {
      "extractionState": "manual",
      "localizations": {
