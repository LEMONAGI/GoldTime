    "timeWindow.error.crossesMidnight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end time must be later than the start time. Split a window that crosses midnight into two."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻は開始時刻より後にしてください。深夜0時をまたぐ時間帯は2つに分けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시각은 시작 시각보다 늦어야 해요. 자정을 넘는 시간대는 두 개로 나눠 주세요."
          }
        }
      }
    },
    "timeWindow.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one time window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックする時間帯を1つ以上追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 시간대를 1개 이상 추가해 주세요."
          }
        }
      }
    },
    "timeWindow.error.outOfRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time window isn't valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯の設定が正しくありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대 설정이 올바르지 않아요."
          }
        }
      }
    },
    "timeWindow.error.overlapping": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some time windows overlap. Adjust them and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重なっている時間帯があります。時間帯を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겹치는 시간대가 있어요. 시간대를 조정해 주세요."
          }
        }
      }
    },
