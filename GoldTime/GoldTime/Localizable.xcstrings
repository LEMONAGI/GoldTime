    "lock.nearMidnight.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 11:45 PM, usage can't be tracked during an extension. The lock will stay off until 11:59 PM, then the rule will restart at midnight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "23:45以降は延長しても使用量を計測できないため23:59までロックが解除されたままになり、00:00からルールが再び適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "23:45부터는 연장 시 사용량 추적이 불가능해 23:59까지 잠금이 해제되며, 00:00부터 규칙이 다시 적용됩니다."
          }
        }
      }
    },
    "lock.noGroups.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app again, or check the monitoring status in GoldTime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開き直すか、GoldTimeでモニタリング状態を確認してください。"
