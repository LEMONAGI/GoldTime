          }
        }
      }
    },
    "onboarding.dialog.tracking.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow “GoldTime” to Track Your Activity Across Other Companies’ Apps and Websites?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“GoldTime”がトラッキングの許可を求めています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
