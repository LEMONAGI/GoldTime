    },
    "rule.cooldown.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use up your allowance and the group locks. Once the break is over, it recharges. It also resets at midnight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用時間の分だけ使うとロックされ、休憩の間隔が過ぎると再びチャージされます。毎日深夜0時にもリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 시간만큼 쓰면 잠기고, 휴식 간격만큼 지나면 다시 충전돼요. 매일 자정에도 새로 시작해요."
          }
        }
      }
    },
    "rule.cooldown.rest": {
