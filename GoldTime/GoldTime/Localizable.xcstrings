    "onboarding.error.screenTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time access is required. Tap the button again and allow access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムの権限が必要です。もう一度ボタンを押して権限を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린타임 권한이 필요해요. 다시 한 번 버튼을 눌러 권한을 허용해주세요."
          }
        }
      }
    },
    "onboarding.intro.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you go over a limit you set,\nyour chosen apps will lock.\nMore time costs an ad.\nWe'll make that moment hard to ignore,\nso you remember what your time is worth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で決めた上限を超えると選んだアプリがロックされ、\nもっと使うには広告で時間を購入する必要があります。\nあなたが時間の大切さを感じられるように、\n上限を超える瞬間を意識させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스스로 정한 한도를 넘기면 선택한 앱이 잠기고,\n더 쓰려면 광고로 시간을 구매해야 합니다.\n당신이 시간의 소중함을 느낄 수 있도록,\n한도를 넘기는 순간을 의식하게 만들겠습니다."
          }
        }
      }
    },
    "onboarding.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Is Money"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時は金なり"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 금이다"
          }
        }
      }
    },
    "onboarding.note.notification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose ‘Allow,’ not ‘Allow in Scheduled Summary,’ to receive notifications immediately"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「時刻指定要約で許可」ではなく「許可」を選ぶと、すぐに通知を受け取れます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'시간 지정 요약에서 허용'이 아닌 '허용'을 선택해야 즉시 알림을 받을 수 있어요"
          }
        }
      }
    },
    "onboarding.note.screenTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to allow this permission to use the app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この権限を許可しないとアプリを使用できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한을 허용해야 앱을 사용할 수 있어요"
          }
        }
      }
    },
    "onboarding.note.tracking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ads still appear if you decline, and the app works the same"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否しても広告は表示され、アプリの利用に制限はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거부해도 광고는 표시되며 앱 이용에 제한이 없어요"
          }
        }
      }
    },
    "onboarding.notification.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Notifications"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を許可する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 허용하기"
          }
        }
      }
    },
    "onboarding.notification.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll notify you when you're close to a limit.\nYou can turn this on later in Settings if you prefer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限が近づくと通知でお知らせします。\nご希望でなければ、後で設定からオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도에 가까워지면 알림으로 알려드려요.\n원하지 않으면 나중에 설정에서 켤 수 있어요."
          }
        }
      }
    },
    "onboarding.notification.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 하기"
          }
        }
      }
    },
    "onboarding.notification.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification Access"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の権限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한"
          }
        }
      }
    },
    "onboarding.screenTime.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムを許可する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린타임 허용하기"
          }
        }
      }
    },
    "onboarding.screenTime.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GoldTime needs Screen Time access\nto track app usage and lock apps\nwhen you go over your limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの使用時間を計測し、\n上限を超えるとアプリをロックするために\nスクリーンタイムへのアクセス権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 사용 시간을 추적하고\n한도를 초과하면 앱을 잠그기 위해\n스크린타임 접근 권한이 필요해요."
          }
        }
      }
    },
    "onboarding.screenTime.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time Access"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムの権限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린타임 권한"
          }
        }
      }
    },
    "onboarding.tracking.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하기"
          }
        }
      }
    },
    "onboarding.tracking.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GoldTime is supported by advertisements.\nEnabling tracking allows us to deliver more relevant ads. You will still see ads even if you opt out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoldTimeは広告ベースのアプリです。\n広告トラッキングを許可すると、より関連性の高い広告が表示されます。\n拒否しても広告は引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GoldTime은 광고 기반 앱입니다.\n광고 추적을 허용하면 더 관련성 높은 광고가 표시돼요.\n거부해도 광고는 계속 표시됩니다."
          }
        }
      }
    },
    "onboarding.tracking.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Personalized Ads"
