    "onboarding.tracking.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GoldTime is supported by advertisements.\nEnabling tracking allows us to deliver more relevant ads. You will still see ads even if you opt out."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GoldTime은 광고 기반 앱입니다.\n광고 추적을 허용하면 더 관련성 높은 광고가 표시돼요.\n거부해도 광고는 계속 표시됩니다."
          }
        }
      }
