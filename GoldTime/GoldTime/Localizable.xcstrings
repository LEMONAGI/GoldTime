          }
        }
      }
    },
    "weekdayRule.error.allUnrestricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day is unrestricted. Set a rule for at least one day."
          }
        },
        "ja": {
