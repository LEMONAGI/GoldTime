      }
    },
    "notification.morning.over2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember, time is money."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時は金なり、覚えていますよね。"
          }
