{
  "sourceLanguage": "ko",
  "strings": {
    "notification.morning.onTime.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A good day. Not for me, obviously."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いい一日でしたね。私にとっては違いますけど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 하루였어요. 저한텐 아니고요."
          }
        }
      }
    },
    "notification.morning.onTime.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayed within your limits yesterday."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日は上限をキープ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제 한도 내 사용."
          }
        }
      }
    },
    "notification.morning.over.title %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min over yesterday."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日は%lld分オーバー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제 %lld분 초과."
          }
        }
      }
    },
    "notification.morning.over1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can let this one slide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これくらいなら見逃してあげます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정도면 살짝 눈 감아드릴게요."
          }
        }
      }
    },
    "notification.morning.over2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember, time is money."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時は金なり、覚えていますよね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 금이라는 거 기억하시죠."
          }
        }
      }
    },
    "notification.morning.over3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday's bill was a little heavy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日の請求書は少し分厚めでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제 청구서가 좀 두꺼웠어요."
          }
        }
      }
    },
    "notification.morning.over4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You did all that for me, didn't you?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは私のために頑張ってくれたんですよね？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정도면 저를 위해 노력하신 거죠?"
          }
        }
      }
    },
    "notification.morning.weekStart.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check last week's numbers in Stats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先週の記録を統計で確認してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 주 기록을 통계에서 확인해보세요."
          }
        }
      }
    },
    "notification.morning.weekStart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new week has started."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい一週間が始まりましたね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 한 주가 시작됐네요."
          }
        }
      }
    },
    "notification.recharge.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식이 끝났어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your break is over"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩が終わりました"
          }
        }
      }
    },
    "notification.recharge.title %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 다시 사용 가능해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is available again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ また使えます"
          }
        }
      }
    },
    "notification.usage.cooldown.almost.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠기기까지 %lld분"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min until locked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックまで%lld分"
          }
        }
      }
    },
    "notification.usage.cooldown.almost.title %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 곧 휴식이에요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — break coming up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ もうすぐ休憩です"
          }
        }
      }
    },
    "notification.usage.cooldown.half.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식까지 %lld분"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min until your break"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩まで%lld分"
          }
        }
      }
    },
    "notification.usage.cooldown.half.title %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 절반 썼어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — halfway used"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 半分使いました"
          }
        }
      }
    },
    "notification.usage.daily.almost.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도까지 %lld분"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min left"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%lld分"
          }
        }
      }
    },
    "notification.usage.daily.almost.title %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 한도가 거의 찼어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — almost at your limit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ もうすぐ上限です"
          }
        }
      }
    },
    "notification.usage.daily.half.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도까지 %lld분"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min left"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%lld分"
          }
        }
      }
    },
    "notification.usage.daily.half.title %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 한도 절반 썼어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — halfway to your limit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上限の半分を使いました"
          }
        }
      }
    },
    "notification.usage.override.almost.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 잠기기까지 %lld분"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min until locked again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ロックまで%lld分"
          }
        }
      }
    },
    "notification.usage.override.almost.title %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 추가 시간 거의 끝났어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — bonus time almost up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 追加時間がもうすぐ終わります"
          }
        }
      }
    },
    "notification.usage.override.half.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 잠기기까지 %lld분"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min until locked again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ロックまで%lld分"
          }
        }
      }
    },
    "notification.usage.override.half.title %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 추가 시간 절반 썼어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — half your bonus time used"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 追加時間を半分使いました"
          }
        }
      }
    }
  },
  "version": "1.0"
}
